<!DOCTYPE html>

<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no" name="viewport"/>
<title>岛屿</title>
<meta content="#000000" id="themeColorMeta" name="theme-color"/>
<meta content="yes" name="apple-mobile-web-app-capable"/>
<meta content="black-translucent" name="apple-mobile-web-app-status-bar-style"/>
<link href="./manifest.webmanifest" rel="manifest"/>
<link href="./assets/icons/icon-192.png" rel="icon" type="image/png"/>
<link href="./assets/icons/icon-180.png" rel="apple-touch-icon"/>
<meta content="yes" name="mobile-web-app-capable"/>
<meta content="岛屿" name="application-name"/>
<meta content="岛屿" name="apple-mobile-web-app-title"/>
<link href="./assets/css/app.css" rel="stylesheet"/>
</head>
<body>
<div aria-hidden="true" class="wallpaper"></div>
<div aria-hidden="true" class="os-status-bar" id="osStatusBar">
<span class="sb-time" id="statusTime">9:41</span>
<span aria-hidden="true" class="sb-icons">
<svg height="11" viewbox="0 0 18 12" width="17">
<rect fill="currentColor" height="4.5" rx="1" width="3" x="0" y="7.5"></rect>
<rect fill="currentColor" height="6.5" rx="1" width="3" x="5" y="5.5"></rect>
<rect fill="currentColor" height="9" rx="1" width="3" x="10" y="3"></rect>
<rect fill="currentColor" height="11.5" opacity=".3" rx="1" width="3" x="15" y="0.5"></rect>
</svg>
<svg height="11" viewbox="0 0 16 12" width="15">
<path d="M8 10.6 9.55 8.9a2.3 2.3 0 0 0-3.1 0z" fill="currentColor"></path>
<path d="M3.6 6.4a6.6 6.6 0 0 1 8.8 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path>
<path d="M1.1 3.7a10.2 10.2 0 0 1 13.8 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path>
</svg>
<svg height="12" viewbox="0 0 26 13" width="25">
<rect fill="none" height="11.8" opacity=".38" rx="3.4" stroke="currentColor" stroke-width="1.1" width="21.5" x="0.6" y="0.6"></rect>
<rect fill="currentColor" height="8.4" rx="2" width="14" x="2.3" y="2.3"></rect>
<path d="M24.2 4.4v4.2a2.2 2.2 0 0 0 0-4.2z" fill="currentColor" opacity=".38"></path>
</svg>
</span>
</div>
<div class="boot" id="boot">
<div class="boot-stage">
<div aria-hidden="true" class="boot-symbol">
<svg viewbox="0 0 32 32">
<path d="M6.5 21.5V10.8c0-1.8 2.3-2.5 3.3-.9l6.2 10 6.2-10c1-1.6 3.3-.9 3.3.9v10.7"></path>
</svg>
</div>
<div class="boot-word">岛屿</div>
<div class="boot-sub">AI-NATIVE PERSONAL OS</div>
<div class="boot-status"><i></i><span>Preparing your space</span></div>
</div>
<div aria-hidden="true" class="boot-line"><span></span></div>
</div>
<main class="home" id="home">
<section class="home-body">
<section class="hero-card home-time-widget" id="homeTimeWidget">
<div class="hero-row">
<span class="hero-kicker">Local Time</span>
<span class="hero-mode"><i></i>Personal Space</span>
</div>
<div class="w-time" id="widgetTime">9:41</div>
<div class="hero-foot">
<div>
<div class="w-date" id="widgetDate">9月20日 星期日</div>
<div class="hero-caption">Quiet interface · made for focus</div>
</div>
<div class="hero-progress">
<div class="hero-progress-head"><span>Day</span><span>Progress</span></div>
<div class="w-day"><i id="dayBar"></i></div>
</div>
</div>
</section>
<section class="home-section home-music-widget" id="homeMusicWidget">
<div class="media-card">
<div aria-hidden="true" class="album"></div>
<div class="music-meta">
<div class="music-title" id="musicTitle">Midnight Drive</div>
<div class="music-artist" id="musicArtist">Mono Waves</div>
<div class="music-progress"><i id="musicBar"></i></div>
</div>
<div class="music-controls">
<button aria-label="上一首" class="m-btn" id="musicPrev" type="button">
<svg aria-hidden="true" viewbox="0 0 24 24"><path d="M18.5 6.6v10.8a1 1 0 0 1-1.53.85l-8.4-5.4a1 1 0 0 1 0-1.7l8.4-5.4a1 1 0 0 1 1.53.85z" fill="currentColor"></path><rect fill="currentColor" height="12" rx="1.2" width="2.4" x="5" y="6"></rect></svg>
</button>
<button aria-label="播放 / 暂停" class="m-btn m-play" id="musicToggle" type="button"></button>
<button aria-label="下一首" class="m-btn" id="musicNext" type="button">
<svg aria-hidden="true" viewbox="0 0 24 24"><path d="M5.5 6.6v10.8a1 1 0 0 0 1.53.85l8.4-5.4a1 1 0 0 0 0-1.7L7.03 5.75a1 1 0 0 0-1.53.85z" fill="currentColor"></path><rect fill="currentColor" height="12" rx="1.2" width="2.4" x="16.6" y="6"></rect></svg>
</button>
</div>
</div>
</section>
<section class="home-section">
<div class="app-grid">
<button class="app" data-app="聊天" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">聊</span></span><span class="app-name">聊天</span></button>
<button class="app" data-app="通讯录" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">通</span></span><span class="app-name">通讯录</span></button>
<button class="app" data-app="相册" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">相</span></span><span class="app-name">相册</span></button>
<button class="app" data-app="日历" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">日</span></span><span class="app-name">日历</span></button>
<button class="app" data-app="备忘录" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">备</span></span><span class="app-name">备忘录</span></button>
<button class="app" data-app="天气" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">天</span></span><span class="app-name">天气</span></button>
<button class="app" data-app="时钟" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">时</span></span><span class="app-name">时钟</span></button>
<button class="app" data-app="设置" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">设</span></span><span class="app-name">设置</span></button>
</div>
</section>
</section>
<nav class="dock">
<button class="app" data-app="电话" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">电</span></span><span class="app-name">电话</span></button>
<button class="app" data-app="浏览器" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">浏</span></span><span class="app-name">浏览器</span></button>
<button class="app" data-app="世界书" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">书</span></span><span class="app-name">世界书</span></button>
<button class="app" data-app="音乐" type="button"><span aria-hidden="true" class="app-icon"><span class="app-glyph">音</span></span><span class="app-name">音乐</span></button>
</nav>
</main>
<div aria-hidden="true" class="chat-app" data-chat-appearance="mono" id="chatApp">
<div class="chat-shell">
<div class="chat-body">
<section class="tab-panel is-active" data-panel="chats">
<header class="panel-head">
<button aria-label="返回桌面" class="ph-btn js-back" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<h1 class="ph-title">消息</h1>
<div class="ph-actions">
<button aria-label="搜索" class="ph-btn js-search" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.9" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
</button>
<button aria-label="添加人设" class="ph-btn js-add" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 8.4v7.2M8.4 12h7.2"></path></svg>
</button>
</div>
</header>
<div class="search-head">
<div class="search-field">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
<input autocomplete="off" class="search-input" placeholder="搜索会话" type="search"/>
</div>
<button class="search-cancel" type="button">取消</button>
</div>
<div class="panel-scroll"><ul class="list" id="chatList"></ul></div>
</section>
<section class="tab-panel" data-panel="contacts">
<header class="panel-head">
<button aria-label="返回桌面" class="ph-btn js-back" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<h1 class="ph-title">联系人</h1>
<div class="ph-actions">
<button aria-label="搜索" class="ph-btn js-search" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.9" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
</button>
<button aria-label="添加人设" class="ph-btn js-add" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 8.4v7.2M8.4 12h7.2"></path></svg>
</button>
</div>
</header>
<div class="search-head">
<div class="search-field">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4 4"></path></svg>
<input autocomplete="off" class="search-input" placeholder="搜索联系人" type="search"/>
</div>
<button class="search-cancel" type="button">取消</button>
</div>
<div class="panel-scroll"><div id="contactList"></div></div>
</section>
<section class="tab-panel" data-panel="moments">
<header class="panel-head">
<button aria-label="返回桌面" class="ph-btn js-back" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<h1 class="ph-title">朋友圈</h1>
<div class="ph-actions">
<button aria-label="发布" class="ph-btn" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><path d="M4 12h13"></path><path d="M12.5 6.5 18 12l-5.5 5.5"></path></svg>
</button>
</div>
</header>
<div class="panel-scroll" id="momentList"></div>
</section>
<section class="tab-panel" data-panel="me">
<header class="panel-head">
<button aria-label="返回桌面" class="ph-btn js-back" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<h1 class="ph-title">我</h1>
<div class="ph-actions">
<button aria-label="设置" class="ph-btn" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24">
<circle cx="12" cy="12" r="3"></circle>
<path d="M12 3.2v2.1M12 18.7v2.1M20.8 12h-2.1M5.3 12H3.2 M18.2 5.8l-1.5 1.5M7.3 16.7l-1.5 1.5 M18.2 18.2l-1.5-1.5M7.3 7.3 5.8 5.8"></path>
</svg>
</button>
</div>
</header>
<div class="panel-scroll">
<div class="me-card">
<div class="avatar avatar-lg" id="meAvatar" style="--deg:150deg">我</div>
<div>
<div class="me-name" id="meName">我</div>
<div class="me-id" id="meId">点击「我的角色」查看和编辑</div>
<div class="me-sign" id="meSign">在虚构里，认真地活着。</div>
</div>
</div>
<div class="me-menu">
<button class="me-item" id="gotoUserPersonas" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.5 19.5a6.5 6.5 0 0 1 13 0"></path></svg>
<span>我的角色</span>
<span class="me-state" id="userPersonaState">1 个</span>
<svg class="chev" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
<button class="me-item" id="openAppearanceFromChat" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor" opacity=".25"></path></svg>
<span>外观</span>
<span class="me-state chat-appearance-state" id="chatAppearanceState">Mono</span>
<svg class="chev" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
</div>
</div>
</section>
</div>
<nav class="chat-tabs">
<button class="chat-tab is-active" data-tab="chats" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><path d="M20 11.6c0 3.6-3.6 6.5-8 6.5-1 0-2-.15-2.9-.42L5 20l1-3.3C4.7 15.5 4 13.6 4 11.6 4 8 7.6 5.1 12 5.1s8 2.9 8 6.5z"></path></svg>
<span>消息</span>
</button>
<button class="chat-tab" data-tab="contacts" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="9.2" cy="9" r="3.2"></circle><path d="M3.6 19a5.6 5.6 0 0 1 11.2 0"></path><path d="M16 6.2a3 3 0 0 1 0 5.8"></path><path d="M17.4 13.6a5.4 5.4 0 0 1 3 4.4"></path></svg>
<span>联系人</span>
</button>
<button class="chat-tab" data-tab="moments" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M15.5 8.5 13.4 13.4 8.5 15.5l2.1-4.9z"></path></svg>
<span>朋友圈</span>
</button>
<button class="chat-tab" data-tab="me" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.5 19.5a6.5 6.5 0 0 1 13 0"></path></svg>
<span>我</span>
</button>
</nav>
</div>
<div aria-hidden="true" class="chat-appearance-view" id="chatAppearanceView">
<div class="chat-appearance-shell">
<header class="panel-head">
<button aria-label="返回我" class="ph-btn js-chat-appearance-back" type="button"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg></button>
<h1 class="ph-title">外观</h1><div class="ph-actions"></div>
</header>
<div class="panel-scroll"><div class="settings-section-title">Chat Style</div><div class="theme-menu" id="chatAppearanceMenu">
<button aria-checked="false" class="theme-option chat-theme-option" data-chat-appearance-choice="mono" role="radio" type="button"><span class="theme-option-main"><strong>Mono</strong></span><span aria-hidden="true" class="appearance-switch"></span></button>
<button aria-checked="false" class="theme-option chat-theme-option" data-chat-appearance-choice="soft" role="radio" type="button"><span class="theme-option-main"><strong>柔和</strong></span><span aria-hidden="true" class="appearance-switch"></span></button>
</div></div>
</div>
</div>
<div aria-hidden="true" class="pm-view" id="pmView">
<div class="pm-shell">
<header class="pm-head">
<button aria-label="返回消息" class="ph-btn" id="pmBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-head-center">
<div class="pm-title" id="pmTitle">角色</div>
</div>
<button aria-label="设置" class="ph-btn" id="pmMore" type="button">
<svg aria-hidden="true" fill="currentColor" viewbox="0 0 24 24">
<circle cx="5.5" cy="12" r="1.9"></circle>
<circle cx="12" cy="12" r="1.9"></circle>
<circle cx="18.5" cy="12" r="1.9"></circle>
</svg>
</button>
</header>
<div class="pm-scroll" id="pmScroll"></div>
<div aria-hidden="true" class="pm-message-action-popover" id="pmMessageActionPopover"></div>
<div class="pm-panel" id="pmPanel">
<div class="pm-panel-inner" id="pmPanelInner"></div>
</div>
<section aria-hidden="true" class="pm-voice-call-view" id="pmVoiceCallView">
<div class="pm-voice-call-shell">
<header class="pm-voice-call-head">
<button aria-label="返回聊天" class="ph-btn" id="pmVoiceCallBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-voice-call-head-center">
<div class="pm-voice-call-label">语音通话</div>
<div class="pm-voice-call-name" id="pmVoiceCallName">角色</div>
</div>
<div class="pm-voice-call-head-spacer"></div>
</header>
<div class="pm-voice-call-body">
<div class="pm-voice-call-profile">
<div class="pm-voice-call-avatar" id="pmVoiceCallAvatar">角</div>
<div class="pm-voice-call-profile-name" id="pmVoiceCallProfileName">角色</div>
<div class="pm-voice-call-status" id="pmVoiceCallStatus">正在连接…</div>
<div class="pm-voice-call-duration" id="pmVoiceCallDuration">00:00</div>
</div>
<div class="pm-voice-call-turns" id="pmVoiceCallTurns">
<div class="pm-voice-call-empty" id="pmVoiceCallEmpty">可以直接说话，也可以切换成文字输入。</div>
</div>
</div>
<div class="pm-voice-call-incoming-actions" id="pmVoiceCallIncomingActions" hidden>
<button class="pm-voice-call-incoming-decline" id="pmVoiceCallIncomingDecline" type="button">拒接</button>
<button class="pm-voice-call-incoming-accept" id="pmVoiceCallIncomingAccept" type="button">接听</button>
</div>
<div class="pm-voice-call-composer" id="pmVoiceCallComposer">
<div class="pm-voice-call-input-row">
<button aria-label="开始说话" class="pm-voice-call-mic" id="pmVoiceCallMicBtn" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24"><rect height="10.5" rx="5.2" width="7" x="8.5" y="3.2"></rect><path d="M5.5 11.2a6.5 6.5 0 0 0 13 0M12 17.7v3.1M9 20.8h6"></path></svg>
</button>
<div class="pm-voice-call-textbox" id="pmVoiceCallTextbox">
<textarea autocomplete="off" id="pmVoiceCallInput" maxlength="2000" placeholder="输入文字，或点击左侧说话……" rows="1"></textarea>
<button aria-label="发送文字" class="pm-voice-call-send" id="pmVoiceCallSend" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" viewbox="0 0 24 24"><path d="M4.5 12h14"></path><path d="m13.5 6 6 6-6 6"></path></svg>
</button>
</div>
<button aria-label="结束通话" class="pm-voice-call-end" id="pmVoiceCallEnd" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24"><path d="M7.2 3.8 9.4 8l-2 2.2a12 12 0 0 0 6.4 6.4l2.2-2 4.2 2.2-1 3.2c-.3.9-1.2 1.4-2.1 1.2C10.4 19.7 4.3 13.6 2.8 6.9c-.2-.9.3-1.8 1.2-2.1z"></path><path d="m17.1 5.9 2.8 2.8M19.9 5.9l-2.8 2.8"></path></svg>
</button>
</div>
<div class="pm-voice-call-foot-hint" id="pmVoiceCallHint">点击麦克风后自动检测你开始和结束说话，不需要长按。</div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-location-map-view" id="pmLocationMapView">
<header class="pm-location-map-head">
<button aria-label="返回聊天" class="ph-btn" id="pmLocationMapBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-location-map-head-center">
<div class="pm-location-map-title" id="pmLocationMapTitle">位置</div>
</div>
<button class="pm-location-map-apps" id="pmLocationMapApps" type="button">选择地图</button>
</header>
<div class="pm-location-map-body">
<div class="pm-location-map-frame-wrap">
<iframe class="pm-location-map-frame" id="pmLocationMapFrame" loading="lazy" referrerpolicy="no-referrer" title="地图"></iframe>
<div class="pm-location-map-fallback" hidden="" id="pmLocationMapFallback">
<div class="pm-location-map-pin-large">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24"><path d="M12 21s6.5-5.4 6.5-10.4a6.5 6.5 0 1 0-13 0C5.5 15.6 12 21 12 21z"></path><circle cx="12" cy="10.4" r="2.4"></circle></svg>
</div>
<div>地图预览暂时无法加载</div>
<button id="pmLocationMapAppsFallback" type="button">选择手机地图应用</button>
</div>
</div>
<div class="pm-location-map-info">
<div class="pm-location-map-info-title" id="pmLocationMapInfoTitle">我的当前位置</div>
<div class="pm-location-map-info-meta" id="pmLocationMapInfoMeta">当前位置</div>
<button class="pm-location-map-open" id="pmLocationMapOpen" type="button">选择地图应用打开</button>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-home-view" id="pmMemoryHomeView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回聊天" class="ph-btn" id="pmMemoryHomeBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-memory-head-center">
<div class="pm-memory-title">记忆</div>
<div class="pm-memory-subtitle" id="pmMemoryHomeChatName">当前聊天</div>
</div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title">短期记忆</div>
<div class="pm-memory-home-card">
<button class="pm-memory-entry" id="pmShortTermMemoryEntry" type="button">
<span aria-hidden="true" class="pm-memory-entry-icon">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24">
<path d="M12 5.2c-1.6-1.15-3.65-1.7-6.5-1.7v13.4c2.85 0 4.9.55 6.5 1.7 1.6-1.15 3.65-1.7 6.5-1.7V3.5c-2.85 0-4.9 0.55-6.5 1.7z"></path>
<path d="M12 5.2v13.4"></path>
</svg>
</span>
<span class="pm-memory-entry-copy">
<strong>短期记忆</strong>
<em>查看当前聊天已经总结的记忆记录；旧记忆会按时间自然衰减</em>
</span>
<span class="pm-memory-entry-meta" id="pmShortTermMemoryCount">0 条总结</span>
<svg aria-hidden="true" class="pm-memory-entry-chevron" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
</div>
<div class="pm-memory-home-card pm-memory-home-card-stack">
<button class="pm-memory-entry" id="pmFuzzyMemoryEntry" type="button">
<span aria-hidden="true" class="pm-memory-entry-icon">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M7.7 13.2c1.15-1.8 2.55-2.7 4.2-2.7 1.65 0 3.05.9 4.2 2.7"></path><circle cx="9.1" cy="10.1" r=".8" fill="currentColor" stroke="none"></circle><circle cx="14.9" cy="10.1" r=".8" fill="currentColor" stroke="none"></circle></svg>
</span>
<span class="pm-memory-entry-copy">
<strong>模糊记忆</strong>
<em>记得发生过什么，但时间和细节会自然变得不精确。</em>
</span>
<span class="pm-memory-entry-meta" id="pmFuzzyMemoryCount">0 条记忆</span>
<svg aria-hidden="true" class="pm-memory-entry-chevron" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
<button class="pm-memory-entry" id="pmFishMemoryEntry" type="button">
<span aria-hidden="true" class="pm-memory-entry-icon">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><path d="M4 12c2.3-3.6 5-5.4 8-5.4s5.7 1.8 8 5.4c-2.3 3.6-5 5.4-8 5.4S6.3 15.6 4 12Z"></path><path d="m4.3 12-2 2.3M4.3 12l-2-2.3"></path><circle cx="14.7" cy="10.3" r=".8" fill="currentColor" stroke="none"></circle></svg>
</span>
<span class="pm-memory-entry-copy">
<strong>鱼的记忆</strong>
<em>只剩事件重点，时间、过程和细枝末节已经淡掉。</em>
</span>
<span class="pm-memory-entry-meta" id="pmFishMemoryCount">0 条记忆</span>
<svg aria-hidden="true" class="pm-memory-entry-chevron" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
</div>
<div class="pm-memory-section-title">重要记忆</div>
<div class="pm-memory-home-card">
<button class="pm-memory-entry" id="pmImportantMemoryEntry" type="button">
<span aria-hidden="true" class="pm-memory-entry-icon">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24">
<path d="m12 3.8 2.45 4.98 5.5.8-3.98 3.87.94 5.47L12 16.34l-4.91 2.58.94-5.47-3.98-3.87 5.5-.8L12 3.8z"></path>
</svg>
</span>
<span class="pm-memory-entry-copy">
<strong>重要记忆</strong>
<em>查看当前聊天需要长期保留的重要信息</em>
</span>
<span class="pm-memory-entry-meta" id="pmImportantMemoryCount">0 条记忆</span>
<svg aria-hidden="true" class="pm-memory-entry-chevron" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
</div>
<div class="pm-memory-section-title">记忆库</div>
<div class="pm-memory-home-card pm-memory-home-card-stack">
<button class="pm-memory-entry" id="pmVectorMemoryEntry" type="button">
<span aria-hidden="true" class="pm-memory-entry-icon"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><circle cx="7" cy="7" r="2"></circle><circle cx="17" cy="6" r="2"></circle><circle cx="8" cy="17" r="2"></circle><path d="m8.7 8.3 6.6-1.6M8.4 8.7l-1 6.4M10 16.6l5.3-8.7"></path></svg></span>
<span class="pm-memory-entry-copy"><strong>向量记忆</strong><em>当前 Char 独立的语义记忆库，从聊天原文提取独立语义片段后再向量化。</em></span>
<span class="pm-memory-entry-meta" id="pmVectorMemoryCount">0 条记忆</span>
<svg aria-hidden="true" class="pm-memory-entry-chevron" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5"></path></svg>
</button>
</div>
<div class="pm-memory-section-title">记忆使用方式</div>
<div class="pm-memory-card pm-memory-mode-card" id="pmMemoryRetrievalMode">
<button type="button" class="pm-memory-mode-option" data-memory-mode="summary"><strong>传统总结</strong><span>使用短期 / 重要记忆</span></button>
<button type="button" class="pm-memory-mode-option" data-memory-mode="vector"><strong>向量记忆</strong><span>语义召回当前 Char 的记忆库</span></button>
<button type="button" class="pm-memory-mode-option" data-memory-mode="hybrid"><strong>两者结合</strong><span>总结记忆 + 向量检索同时注入</span></button>
</div>
<div class="pm-memory-section-title">记忆衰减</div>
<div class="pm-memory-card pm-memory-aging-card">
<div class="pm-memory-row">
<div class="pm-memory-copy">
<strong>清晰记忆</strong>
<em>最近这段时间保留具体时间、人物和事件细节。</em>
</div>
<div class="pm-memory-number-wrap"><input class="pm-memory-number" id="pmMemoryClearDays" inputmode="numeric" min="1" step="1" type="number" value="3"/><span>天</span></div>
</div>
<div class="pm-memory-divider"></div>
<div class="pm-memory-row">
<div class="pm-memory-copy">
<strong>模糊记忆</strong>
<em>到这个期限前仍记得事情，但时间会变成大概月份或“几个月前”。</em>
</div>
<div class="pm-memory-number-wrap"><input class="pm-memory-number" id="pmMemoryFuzzyDays" inputmode="numeric" min="2" step="1" type="number" value="30"/><span>天</span></div>
</div>
<div class="pm-memory-divider"></div>
<div class="pm-memory-row">
<div class="pm-memory-copy">
<strong>鱼的记忆</strong>
<em>到这个期限前只保留重点，不再可靠记得具体时间与细节。</em>
</div>
<div class="pm-memory-number-wrap"><input class="pm-memory-number" id="pmMemoryFishDays" inputmode="numeric" min="3" step="1" type="number" value="365"/><span>天</span></div>
</div>
<div class="pm-memory-aging-hint" id="pmMemoryTierHint">最近 3 天清晰；3～30 天模糊；30～365 天只留重点；超过 365 天自动淡出。重要记忆永久保留。</div>
</div>

<div class="pm-memory-actions">
<button class="pm-memory-action primary" id="pmMemorySummarize" type="button">立即总结当前聊天</button>
<button class="pm-memory-action danger" id="pmMemoryClearButton" type="button">清空记忆</button>
</div>
<div class="pm-memory-section-title">上下文</div>
<div class="pm-memory-card">
<div class="pm-memory-row">
<div class="pm-memory-copy">
<strong>上下文深度</strong>
</div>
<div class="pm-memory-number-wrap"><input class="pm-memory-number" id="pmMemoryContextDepth" inputmode="numeric" min="1" step="1" type="number" value="40"/><span>条</span></div>
</div>
</div>
<div class="pm-memory-section-title">总结设置</div>
<div class="pm-memory-card">
<div class="pm-memory-row">
<div class="pm-memory-copy">
<strong>开始总结条件</strong>
</div>
<div class="pm-memory-number-wrap"><input class="pm-memory-number" id="pmMemorySummaryThreshold" inputmode="numeric" min="1" step="1" type="number" value="20"/><span>条</span></div>
</div>
<div class="pm-memory-divider"></div>
<div class="pm-memory-prompt-row">
<div class="pm-memory-prompt-top">
<div class="pm-memory-prompt-copy">
<strong>总结格式提示词</strong>
</div>
<select aria-label="总结格式预设" class="pm-memory-preset" id="pmMemorySummaryPreset"></select>
</div>
<div class="saved-preset-field memory-saved-preset-field">
<div class="api-field-head">
<span class="api-label">已保存预设</span>
<span class="api-preset-actions">
<button class="api-hint-btn" id="pmMemorySummaryPresetNew" type="button">＋新建预设</button>
<button class="api-hint-btn" disabled="" id="pmMemorySummaryPresetUpdate" type="button">更新当前</button>
</span>
</div>
<div class="saved-preset-list" id="pmMemorySummaryPresetList"></div>
</div>
<textarea class="pm-memory-prompt" id="pmMemorySummaryPrompt" placeholder="例如：按人物关系、关键事件、当前状态、重要偏好与待继续事项分段总结；只保留会影响后续对话的信息。" rows="7" spellcheck="false"></textarea>
</div>
<div class="pm-memory-divider"></div>
<div class="pm-memory-api-row">
<div class="pm-memory-copy">
<strong>总结 API</strong>
</div>
<span class="pm-memory-api-state" id="pmMemoryApiState">检查中…</span>
</div>
</div>
<div class="pm-memory-section-title">敏感内容总结处理</div>
<div class="pm-memory-card">
<div class="pm-memory-retry-row">
<div class="pm-memory-retry-head">
<div class="pm-memory-retry-copy">
<strong>总结失败重试提示词</strong>
</div>
</div>
<textarea class="pm-memory-prompt" id="pmMemorySummaryRetryPrompt" placeholder="例如：对敏感内容只保留事件类别、人物关系、时间顺序和后续影响，用中性概括描述，不输出露骨细节。" rows="6" spellcheck="false"></textarea>
<div class="pm-memory-retry-actions">
<button class="pm-memory-retry-btn" id="pmMemorySummaryRetrySave" type="button">保存处理规则</button>
<button class="pm-memory-retry-btn primary" id="pmMemorySummaryRetryRun" type="button">用处理规则重试</button>
</div>
</div>
</div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-view" id="pmMemoryView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回记忆" class="ph-btn" id="pmMemoryBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-memory-head-center">
<div class="pm-memory-title">短期记忆</div>
<div class="pm-memory-subtitle" id="pmMemoryShortTermChatName">当前聊天</div>
</div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title">已总结记录</div>
<div class="pm-memory-search" role="search">
<svg aria-hidden="true" class="pm-memory-search-icon" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.4 4.4"></path></svg>
<input aria-label="搜索短期记忆" autocomplete="off" enterkeyhint="search" id="pmMemorySummarySearch" placeholder="搜索短期记忆…" type="search"/>
<button aria-label="清除搜索" class="pm-memory-search-clear" hidden="" id="pmMemorySummarySearchClear" type="button">×</button>
</div>
<div class="pm-memory-history" id="pmMemorySummaryHistory"></div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-view" id="pmFuzzyMemoryView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回记忆" class="ph-btn" id="pmFuzzyMemoryBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-memory-head-center">
<div class="pm-memory-title">模糊记忆</div>
<div class="pm-memory-subtitle" id="pmFuzzyMemoryChatName">当前聊天</div>
</div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title">超过清晰期的记忆</div>
<div class="pm-memory-card pm-memory-tier-note"><strong>记忆规则</strong><span>这里的内容已经经过一次“变模糊”处理：可以记得事情的大意和主要细节，但不能可靠记住具体日期、时间或没有记录的细节。</span></div>
<div class="pm-memory-history" id="pmFuzzyMemoryList"></div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-view" id="pmFishMemoryView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回记忆" class="ph-btn" id="pmFishMemoryBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-memory-head-center">
<div class="pm-memory-title">鱼的记忆</div>
<div class="pm-memory-subtitle" id="pmFishMemoryChatName">当前聊天</div>
</div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title">超过模糊期的记忆</div>
<div class="pm-memory-card pm-memory-tier-note"><strong>记忆规则</strong><span>这里已经只保留事件重点。时间和过程不会被当成可靠事实；如果原文没有明确记录，角色不应该补出日期、月份、地点、动机或具体对白。</span></div>
<div class="pm-memory-history" id="pmFishMemoryList"></div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-view" id="pmVectorMemoryView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回记忆" class="ph-btn" id="pmVectorMemoryBack" type="button"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg></button>
<div class="pm-memory-head-center"><div class="pm-memory-title">向量记忆</div><div class="pm-memory-subtitle" id="pmVectorMemoryChatName">当前聊天</div></div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title pm-vector-memory-section-title">当前 Char 的独立记忆库</div>
<div class="pm-memory-card">
<div class="pm-memory-page-head"><div class="pm-memory-copy"><strong>语义记忆</strong></div><span class="pm-memory-api-state" id="pmVectorMemoryCountPage">0 条记忆</span></div>
<div class="pm-important-memory-page-action">
<button class="pm-memory-action" id="pmVectorMemoryAdd" type="button">添加记忆</button>
<button class="pm-memory-action primary" id="pmVectorMemorySync" type="button">从聊天提取</button>
</div>
</div>
<div class="pm-memory-section-title pm-vector-memory-section-title">记忆条目（可手动重排）</div>
<div class="pm-vector-memory-list" id="pmVectorMemoryList"></div>
</div>
</div>
</section>
<section aria-hidden="true" class="pm-memory-view" id="pmImportantMemoryView">
<div class="pm-memory-shell">
<header class="pm-memory-head">
<button aria-label="返回记忆" class="ph-btn" id="pmImportantMemoryBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<div class="pm-memory-head-center">
<div class="pm-memory-title">重要记忆</div>
<div class="pm-memory-subtitle" id="pmImportantMemoryChatName">当前聊天</div>
</div>
<div class="pm-memory-head-spacer"></div>
</header>
<div class="pm-memory-scroll">
<div class="pm-memory-section-title">长期保留</div>
<div class="pm-memory-card">
<div class="pm-important-memory-page-head">
<div class="pm-memory-copy">
<strong>重要记忆</strong>
<em>从当前短期记忆中摘取值得长期保留的信息。</em>
</div>
<span class="pm-memory-api-state" id="pmImportantMemoryCountPage">0 条记忆</span>
</div>
<div class="pm-important-memory-page-action">
<button class="pm-memory-action" id="pmMemoryImportantAdd" type="button">添加自定义</button>
<button class="pm-memory-action primary" id="pmMemoryImportantExtract" type="button">摘取重要记忆</button>
</div>
</div>
<div class="pm-memory-section-title">已保存的重要记忆</div>
<div class="pm-important-memory-list" id="pmMemoryImportantList"></div>
</div>
</div>
</section>
<div aria-hidden="true" class="pm-memory-clear-modal" id="pmMemoryClearModal">
<div class="pm-memory-clear-backdrop"></div>
<section class="pm-memory-clear-dialog" role="dialog" aria-modal="true" aria-labelledby="pmMemoryClearTitle">
<div class="pm-memory-clear-title" id="pmMemoryClearTitle">清空记忆</div>
<div class="pm-memory-clear-hint">选择要清空的记忆模块。</div>
<label class="pm-memory-clear-option pm-memory-clear-all"><input type="checkbox" id="pmMemoryClearAll"><span><strong>全部记忆</strong><em>清空下面三个模块</em></span></label>
<label class="pm-memory-clear-option"><input type="checkbox" id="pmMemoryClearSummary" checked><span><strong>短期总结记忆</strong><em id="pmMemoryClearSummaryCount">0 条</em></span></label>
<label class="pm-memory-clear-option"><input type="checkbox" id="pmMemoryClearImportant"><span><strong>重要记忆</strong><em id="pmMemoryClearImportantCount">0 条</em></span></label>
<label class="pm-memory-clear-option"><input type="checkbox" id="pmMemoryClearVector"><span><strong>向量记忆</strong><em id="pmMemoryClearVectorCount">0 条</em></span></label>
<div class="pm-memory-clear-actions"><button type="button" class="pm-memory-clear-btn" id="pmMemoryClearCancel">取消</button><button type="button" class="pm-memory-clear-btn danger" id="pmMemoryClearConfirm">确认清空</button></div>
</section>
</div>
<div aria-hidden="true" class="pm-memory-notice" id="pmMemoryNotice">
<div class="pm-memory-notice-backdrop"></div>
<section aria-atomic="true" aria-live="polite" class="pm-memory-notice-dialog" role="status">
<div aria-hidden="true" class="pm-memory-notice-spinner" id="pmMemoryNoticeSpinner"></div>
<div class="pm-memory-notice-title" id="pmMemoryNoticeTitle">正在总结</div>
<div class="pm-memory-notice-text" id="pmMemoryNoticeText">正在整理当前聊天内容，请稍候…</div>
</section>
</div>
<input accept="image/*" hidden="" id="pmImageInput" multiple="" type="file"/>
<input accept="image/*" capture="environment" hidden="" id="pmCameraInput" type="file"/>
<input accept=".txt,.md,.markdown,.json,.jsonl,.csv,.xml,.html,.htm,.css,.js,.ts,.jsx,.tsx,.py,.java,.c,.cpp,.h,.hpp,.log,.yaml,.yml,.toml,.ini,.conf,.sql,.sh,.bat,.docx,text/plain,text/markdown,application/json,application/xml,application/javascript,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-hidden="true" hidden="" id="pmFileInput" multiple="" type="file"/>
<div class="pm-bar" id="pmBar">
<button aria-label="语音" class="pm-bar-btn pm-voice-btn" id="pmVoice" type="button">
<img alt="语音" id="pmVoiceIcon" src="https://nos.netease.com/vcloud-statistic/nrtc/a6ee4a35-6552-49a8-8c87-9256cd426ed5.png" style="width:24px;height:24px;object-fit:contain;display:block;"/>
</button>
<div class="pm-input-wrap">
<textarea autocomplete="off" class="pm-input" id="pmInput" rows="1"></textarea>
<button aria-label="AI 回复" class="pm-bar-btn pm-ai-inside" id="pmAiBtn" type="button">
<img alt="AI 回复" src="https://nos.netease.com/vcloud-statistic/nrtc/cc265253-20f9-49c6-a8d2-e259bce889dd.png"/>
</button>
</div>
<button class="pm-hold" id="pmHold" type="button">按住 说话</button>
<button aria-label="表情" class="pm-bar-btn" id="pmEmojiBtn" type="button">
<img alt="表情" id="pmEmojiIcon" src="https://nos.netease.com/vcloud-statistic/nrtc/54e485a4-5051-4671-a085-9da231afa2f4.png" style="width:24px;height:24px;object-fit:contain;display:block;"/>
</button>
<button aria-label="更多" class="pm-bar-btn" id="pmPlusBtn" type="button">
<img alt="更多" src="https://nos.netease.com/vcloud-statistic/nrtc/baf2a43f-1760-4469-972c-966152b79db9.png" style="width:24px;height:24px;object-fit:contain;display:block;"/>
</button>
</div>
<div aria-hidden="true" class="char-language-modal" id="charLanguageModal">
<div class="char-language-backdrop" data-char-language-close=""></div>
<section aria-labelledby="charLanguageTitle" aria-modal="true" class="char-language-dialog" role="dialog">
<div class="char-language-head">
<div>
<div class="char-language-title" id="charLanguageTitle">角色语言</div>
<div class="char-language-subtitle" id="charLanguageSubtitle">选择后，当前角色将优先使用该语言回复。</div>
</div>
<button aria-label="关闭" class="char-language-close" data-char-language-close="" type="button">×</button>
</div>
<div class="char-language-options" id="charLanguageOptions"></div>
<div class="char-language-split-note" hidden="" id="charLanguageSplitNote">
<div class="char-language-split-copy">
<div class="char-language-split-title">中文断句拆分提示词</div>
<div class="char-language-split-desc">可自行决定是否启用“每条≤15字、标点拆分、空格即拆”等中文专用断句规则，与角色语言独立。</div>
</div>
<button aria-checked="false" class="char-language-switch" id="charLanguageSplitToggle" role="switch" type="button"><span></span></button>
</div>
<div class="char-language-foot">
<button class="char-language-done" id="charLanguageDone" type="button">完成</button>
</div>
</section>
</div>
<div aria-hidden="true" class="pm-location-modal" id="pmLocationModal">
<div class="pm-location-backdrop" data-location-close=""></div>
<section aria-labelledby="pmLocationTitle" aria-modal="true" class="pm-location-dialog" role="dialog">
<div class="pm-location-head">
<div>
<div class="pm-location-title" id="pmLocationTitle">分享位置</div>
<div class="pm-location-subtitle">选择真实的手机当前位置，或创建一个虚拟位置发给 Char。</div>
</div>
<button aria-label="关闭" class="pm-location-close" data-location-close="" type="button">×</button>
</div>
<div class="pm-location-actions">
<button class="pm-location-action" data-location-action="current" type="button">
<span class="pm-location-action-icon"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><path d="M12 21s6.5-5.4 6.5-10.4a6.5 6.5 0 1 0-13 0C5.5 15.6 12 21 12 21z"></path><circle cx="12" cy="10.4" r="2.4"></circle></svg></span>
<span class="pm-location-action-copy"><b>我的当前位置</b><small>使用手机 GPS / 浏览器定位权限</small></span>
<span class="pm-location-chevron">›</span>
</button>
<button class="pm-location-action" data-location-action="virtual" type="button">
<span class="pm-location-action-icon"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewbox="0 0 24 24"><path d="M5 7.5h14M7 4.5h10M6.5 7.5l1.5 12h8l1.5-12"></path><path d="M9.5 11.2h5M9.5 14.6h5"></path></svg></span>
<span class="pm-location-action-copy"><b>自定义虚拟位置</b><small>手动设置名称与经纬度</small></span>
<span class="pm-location-chevron">›</span>
</button>
</div>
<div class="pm-location-status" id="pmLocationStatus"></div>
</section>
</div>
<div aria-hidden="true" class="pm-location-custom-modal" id="pmLocationCustomModal">
<div class="pm-location-backdrop" data-location-custom-close=""></div>
<section aria-labelledby="pmLocationCustomTitle" aria-modal="true" class="pm-location-dialog pm-location-custom-dialog" role="dialog">
<div class="pm-location-head">
<div>
<div class="pm-location-title" id="pmLocationCustomTitle">自定义虚拟位置</div>
<div class="pm-location-subtitle">位置只会作为当前聊天中的一条位置消息发送给 Char。</div>
</div>
<button aria-label="关闭" class="pm-location-close" data-location-custom-close="" type="button">×</button>
</div>
<label class="pm-location-field">
<span>位置名称</span>
<input id="pmLocationCustomLabel" maxlength="40" placeholder="例如：东京塔附近" type="text"/>
</label>
<div class="pm-location-field-row">
<label class="pm-location-field"><span>纬度</span><input id="pmLocationCustomLat" inputmode="decimal" placeholder="35.6586" step="any" type="number"/></label>
<label class="pm-location-field"><span>经度</span><input id="pmLocationCustomLng" inputmode="decimal" placeholder="139.7454" step="any" type="number"/></label>
</div>
<div class="pm-location-custom-hint">支持全球经纬度；发送后会在聊天中显示为虚拟位置，并明确标注“虚拟位置”。</div>
<div class="pm-location-custom-foot">
<button class="pm-location-cancel" data-location-custom-close="" type="button">取消</button>
<button class="pm-location-send" id="pmLocationCustomSend" type="button">发送位置</button>
</div>
</section>
</div>
<div aria-hidden="true" class="pm-transfer-modal" id="pmTransferModal">
<div class="pm-transfer-backdrop" data-transfer-close=""></div>
<section aria-labelledby="pmTransferTitle" aria-modal="true" class="pm-transfer-dialog" role="dialog">
<div class="pm-transfer-head">
<div>
<div class="pm-transfer-title" id="pmTransferTitle">转账给 <span id="pmTransferRecipient">Char</span></div>
<div class="pm-transfer-subtitle">转账会作为一条聊天消息发送，并同步进入 Char 的 AI 上下文。</div>
</div>
<button aria-label="关闭" class="pm-transfer-close" data-transfer-close="" type="button">×</button>
</div>
<label class="pm-transfer-field"><span>金额</span>
<div class="pm-transfer-amount-wrap"><span class="pm-transfer-currency">¥</span><input autocomplete="off" id="pmTransferAmount" inputmode="decimal" max="99999999.99" min="0.01" placeholder="0.00" step="0.01" type="number"></div>
</label>
<div aria-label="快捷金额" class="pm-transfer-quick">
<button data-transfer-quick="10" type="button">¥10</button><button data-transfer-quick="50" type="button">¥50</button><button data-transfer-quick="100" type="button">¥100</button><button data-transfer-quick="200" type="button">¥200</button>
</div>
<label class="pm-transfer-field"><span>备注（可选）</span><textarea id="pmTransferNote" maxlength="80" placeholder="例如：给你买杯奶茶" rows="2"></textarea></label>
<div class="pm-transfer-hint" id="pmTransferHint">请输入 0.01～99,999,999.99 元。</div>
<div class="pm-transfer-foot"><button class="pm-transfer-cancel" data-transfer-close="" type="button">取消</button><button class="pm-transfer-send" id="pmTransferSend" type="button">转账</button></div>
</section>
</div>
<div aria-hidden="true" class="voice-text-modal" id="voiceTextModal">
<div class="voice-text-backdrop" data-voice-text-close=""></div>
<section aria-labelledby="voiceTextTitle" aria-modal="true" class="voice-text-dialog" role="dialog">
<div class="voice-text-head">
<div>
<div class="voice-text-title" id="voiceTextTitle">发送语音消息</div>
<div class="voice-text-subtitle">编辑文字后，会以语音消息气泡发送（无声音）</div>
</div>
<button aria-label="关闭" class="voice-text-close" data-voice-text-close="" type="button">×</button>
</div>
<textarea class="voice-text-input" id="voiceTextInput" maxlength="300" placeholder="输入要发送的语音内容……" rows="4"></textarea>
<div class="voice-text-foot">
<span class="voice-text-hint" id="voiceTextHint">预计 1 秒</span>
<div class="voice-text-actions">
<button class="voice-text-cancel" data-voice-text-close="" type="button">取消</button>
<button class="voice-text-send" id="voiceTextSend" type="button">发送</button>
</div>
</div>
</section>
</div>
</div>
</div>
<div aria-hidden="true" class="up-view" id="upView">
<div class="up-shell">
<header class="panel-head">
<button aria-label="返回" class="ph-btn" id="upBack" type="button">
<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24"><path d="M15 5.5 8.5 12 15 18.5"></path></svg>
</button>
<h1 class="ph-title">我的角色</h1>
